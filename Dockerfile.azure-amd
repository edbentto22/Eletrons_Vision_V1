FROM public.ecr.aws/docker/library/python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    # Otimizações específicas para AMD EPYC
    OMP_NUM_THREADS=4 \
    MKL_NUM_THREADS=4 \
    OPENBLAS_NUM_THREADS=4 \
    # Forçar execução CPU-only para YOLO
    CUDA_VISIBLE_DEVICES="" \
    # Configurações de memória para instância pequena (14GB RAM)
    PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# System deps otimizados para AMD e OpenCV
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgl1 \
    libglib2.0-0 \
    ffmpeg \
    libffi-dev \
    # Bibliotecas otimizadas para AMD
    libomp-dev \
    libopenblas-dev \
    # Ferramentas de sistema
    htop \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt /app/requirements.txt

# Instalar PyTorch CPU-only otimizado para AMD
RUN pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
        torch==2.3.1+cpu torchvision==0.18.1+cpu torchaudio==2.3.1+cpu && \
    pip install -v --no-cache-dir -r /app/requirements.txt

COPY app /app/app

# Configurar limites de recursos para instância pequena
ENV YOLO_BATCH_SIZE=1 \
    YOLO_WORKERS=2 \
    YOLO_IMGSZ=640 \
    # Configurações específicas para Azure NV4as v4
    AZURE_INSTANCE_TYPE=NV4as_v4 \
    GPU_AVAILABLE=false \
    CPU_CORES=4 \
    MEMORY_GB=14

EXPOSE ${PORT:-8000}
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]